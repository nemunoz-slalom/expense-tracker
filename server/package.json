{
  "name": "expense-tracker-server",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:test": "cross-env NODE_ENV=test PORT=5002 DATABASE_PATH=services.test.db node server.js",
    "test": "jest --runInBand --passWithNoTests",
    "test:unit": "jest --runInBand --passWithNoTests __tests__/unit",
    "test:integration": "jest --runInBand --passWithNoTests __tests__/integration",
    "lint": "eslint --no-error-on-unmatched-pattern ."
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "jest": "30.5.1",
    "supertest": "7.2.2"
  },
  "eslintConfig": {
    "env": {
      "es2021": true,
      "node": true
    },
    "extends": "eslint:recommended"
  }
}
