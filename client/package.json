{
  "name": "expense-tracker-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "start:test": "cross-env PORT=3001 REACT_APP_API_URL=http://localhost:5001 react-scripts start",
    "test": "react-scripts test",
    "test:unit": "node -e \"const fs=require('fs'); const {spawnSync}=require('child_process'); if(!fs.existsSync('src')) process.exit(0); const r=spawnSync('react-scripts', ['test','--watchAll=false','--passWithNoTests'], {stdio:'inherit', shell:true}); process.exit(r.status ?? 1);\"",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{js,jsx,ts,tsx}\"",
    "build": "if [ ! -d src ]; then exit 0; fi; react-scripts build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-select": "2.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.34.2",
    "i18next": "23.16.8",
    "lucide-react": "0.575.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "14.1.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "react-scripts": "5.0.1",
    "typescript": "4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
